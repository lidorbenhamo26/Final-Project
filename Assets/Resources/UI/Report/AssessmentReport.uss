/* Assessor report — clinical light "paper" look over a dark scrim.
   Palette: paper #F7F9FB, ink #1E293B, accent #2563EB,
            success #16A34A, fail #DC2626, warn #D97706. */

.report-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 12, 20, 0.92);
    align-items: center;
    justify-content: center;
}

.report-scroll {
    width: 1080px;
    max-width: 96%;
    max-height: 94%;
}

.report-page {
    background-color: rgb(247, 249, 251);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(215, 222, 231);
    padding: 32px 40px;
    margin: 4px;
    /* Inherited default ink for unstyled labels. Never use a `.report-page
       Label` descendant rule here: its (0,1,1) specificity would beat every
       single-class color below (0,1,0) and repaint pills/titles dark. */
    color: rgb(30, 41, 59);
}

/* ------------------------------------------------------------- header */

.header-top-row {
    flex-direction: row;
    align-items: flex-start;
}

.header-title-block {
    flex-grow: 1;
}

.report-title {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(15, 23, 42);
}

.report-subtitle {
    font-size: 13px;
    color: rgb(100, 116, 139);
    margin-top: 2px;
}

.report-badge {
    background-color: rgb(37, 99, 235);
    color: white;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding: 4px 10px;
    border-radius: 4px;
}

.divider {
    height: 1px;
    background-color: rgb(215, 222, 231);
    margin: 14px 0;
}

.demo-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.demo-item {
    width: 33%;
    padding: 6px 12px 6px 0;
}

.demo-label {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(100, 116, 139);
}

.demo-value {
    font-size: 15px;
    color: rgb(15, 23, 42);
    margin-top: 1px;
    white-space: normal;
}

.demo-notes {
    margin-top: 4px;
}

.demo-notes-value {
    white-space: normal;
}

.report-banner {
    background-color: rgb(254, 243, 199);
    border-width: 1px;
    border-color: rgb(217, 119, 6);
    color: rgb(146, 64, 14);
    -unity-font-style: bold;
    font-size: 13px;
    padding: 8px 14px;
    border-radius: 6px;
    margin-top: 12px;
    -unity-text-align: middle-center;
}

/* ------------------------------------------------------------ summary */

.summary-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 16px 0 6px 0;
}

.summary-item {
    flex-grow: 1;
    background-color: white;
    border-width: 1px;
    border-color: rgb(226, 232, 240);
    border-radius: 8px;
    padding: 10px 12px;
    margin: 0 8px 8px 0;
    align-items: center;
    min-width: 130px;
}

.summary-value {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(15, 23, 42);
}

.summary-value--good {
    color: rgb(22, 163, 74);
}

.summary-value--bad {
    color: rgb(220, 38, 38);
}

.summary-caption {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
    color: rgb(100, 116, 139);
    margin-top: 2px;
}

/* --------------------------------------------------------- scale card */

.scale-card {
    background-color: white;
    border-width: 1px;
    border-color: rgb(226, 232, 240);
    border-left-width: 4px;
    border-left-color: rgb(37, 99, 235);
    border-radius: 8px;
    padding: 14px 18px;
    margin: 8px 0;
}

.scale-card--empty {
    border-left-color: rgb(203, 213, 225);
    opacity: 0.85;
}

.scale-header {
    flex-direction: row;
    align-items: center;
}

.scale-title {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: rgb(15, 23, 42);
}

.flex-spacer {
    flex-grow: 1;
}

.scale-desc {
    font-size: 13px;
    color: rgb(71, 85, 105);
    margin-top: 6px;
    white-space: normal;
}

.scale-caption {
    font-size: 12px;
    color: rgb(100, 116, 139);
    -unity-font-style: italic;
    margin-top: 2px;
}

.scale-empty {
    font-size: 13px;
    color: rgb(148, 163, 184);
    margin-top: 10px;
}

.attempt {
    border-top-width: 1px;
    border-top-color: rgb(238, 242, 247);
    margin-top: 12px;
    padding-top: 10px;
}

.attempt-header {
    flex-direction: row;
    align-items: center;
}

.attempt-title {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(100, 116, 139);
    margin-right: 10px;
}

.attempt-rt {
    font-size: 12px;
    color: rgb(100, 116, 139);
    margin-left: 10px;
}

.pill {
    color: white;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.6px;
    padding: 3px 10px;
    border-radius: 99px;
}

.metric-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.metric-row {
    flex-direction: row;
    width: 50%;
    padding: 2px 16px 2px 0;
}

.metric-label {
    font-size: 13px;
    color: rgb(100, 116, 139);
    flex-grow: 1;
}

.metric-value {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(15, 23, 42);
}

.bar-block {
    max-width: 440px;
    margin-top: 8px;
}

.bar-head {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 3px;
}

.bar-label {
    font-size: 12px;
    color: rgb(71, 85, 105);
}

.bar-pct {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(71, 85, 105);
}

.bar-track {
    height: 10px;
    background-color: rgb(226, 232, 240);
    border-radius: 5px;
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    border-radius: 5px;
}

/* ------------------------------------------------------------- footer */

.disclaimer {
    font-size: 11px;
    color: rgb(100, 116, 139);
    white-space: normal;
}

.footer-meta {
    font-size: 11px;
    color: rgb(148, 163, 184);
    margin-top: 6px;
    white-space: normal;
}

.export-status {
    font-size: 12px;
    color: rgb(37, 99, 235);
    margin-top: 6px;
    white-space: normal;
}

.btn-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 14px;
}

.report-btn {
    background-color: white;
    border-width: 1px;
    border-color: rgb(203, 213, 225);
    border-radius: 6px;
    color: rgb(30, 41, 59);
    font-size: 13px;
    -unity-font-style: bold;
    padding: 9px 16px;
    margin: 4px 8px 4px 0;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.report-btn:hover {
    background-color: rgb(239, 244, 255);
}

.report-btn--primary {
    background-color: rgb(37, 99, 235);
    border-color: rgb(37, 99, 235);
    color: white;
}

.report-btn--primary:hover {
    background-color: rgb(29, 78, 216);
}

.report-btn--ghost {
    background-color: transparent;
    border-color: rgb(148, 163, 184);
    color: rgb(71, 85, 105);
}

.report-btn--ghost:hover {
    background-color: rgb(241, 245, 249);
}
